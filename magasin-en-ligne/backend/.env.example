# Copiez ce fichier en ".env" et remplissez vos vraies valeurs

# Port du serveur backend
PORT=5000

# Base de données PostgreSQL locale (base séparée : "magasin")
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=magasin

# Secret pour les tokens JWT
JWT_SECRET=changez-moi-cle-secrete-tres-longue

# Mot de passe de l'espace admin (changez-le !)
ADMIN_MOT_DE_PASSE=admin123

# Email (Gmail recommandé : activez "Mot de passe d'application" sur votre compte Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASS=votre-mot-de-passe-application
